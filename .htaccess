# =============================================================================
# Maitu Co., LIMITED — Apache configuration
# =============================================================================

# --- Canonical host + HTTPS enforcement -------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (except when using a health-check loopback request)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force the canonical host, without www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # Strip the trailing slash from non-root pages
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [L,R=301]
</IfModule>

# --- index.html -> / (301 canonical redirect) --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

<IfModule !mod_rewrite.c>
  RedirectMatch 301 ^/index\.html$ /
</IfModule>

# --- Default document ---------------------------------------------------------
DirectoryIndex index.html index.htm

# --- Custom 404 ---------------------------------------------------------------
ErrorDocument 404 /404.html

# --- Block access to sensitive files -------------------------------------------
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json$|\.log$|\.bak$|\.sql$|\.env$|.*~$|\.swp$)">
  Require all denied
</FilesMatch>

# --- Compression --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Cache headers ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType application/json           "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted assets would allow immutable caching; these are not fingerprinted,
  # so a shorter window is applied to avoid stale releases.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Security headers ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # --- Content Security Policy ---
  # Allows inline styles for critical layout hints and the Google Play / Apple
  # store badge redirects; scripts remain restricted to the site's own bundle.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Remove the fingerprint that identifies the server software
  Header unset X-Powered-By
</IfModule>

# --- MIME types for the sprite -----------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# --- Unicode / UTF-8 ----------------------------------------------------------
AddDefaultCharset UTF-8
